# Supabase project URL.
# Find it in Supabase Dashboard → Project Settings → API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase public anon key for browser/server session operations protected by RLS.
# Find it in Supabase Dashboard → Project Settings → API → Project API keys → anon public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Google Maps browser API key with Maps JavaScript API and Places API enabled.
# Find/create it in Google Cloud Console → APIs & Services → Credentials → API keys.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-browser-api-key
